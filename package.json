{
	"name": "@lesjoursfr/express-session-mongodb",
	"version": "2.0.1",
	"description": "MongoDB session store for express",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lesjoursfr/express-session-mongodb.git"
	},
	"homepage": "https://github.com/lesjoursfr/express-session-mongodb#readme",
	"bugs": {
		"url": "https://github.com/lesjoursfr/express-session-mongodb/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": "22.x || 24.x || 26.x"
	},
	"keywords": [
		"mongo",
		"mongodb",
		"session",
		"express"
	],
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"type": "module",
	"scripts": {
		"freshlock": "rm -rf node_modules/ && rm .yarn/install-state.gz && rm yarn.lock && yarn",
		"check-lint": "eslint",
		"check-format": "prettier --check .",
		"check-tsc": "tsc --noEmit",
		"lint": "eslint --fix",
		"format": "prettier --write .",
		"build": "tsc -p tsconfig.build.json",
		"test": "NODE_OPTIONS='--loader=ts-node/esm' mocha"
	},
	"dependencies": {
		"express": "^5.2.1",
		"express-session": "^1.19.0",
		"mongodb": "~7.3.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@tsconfig/node22": "22.0.5",
		"@types/express": "5.0.6",
		"@types/express-session": "1.19.0",
		"@types/fs-extra": "11.0.4",
		"@types/mocha": "10.0.10",
		"@types/node": "24.13.2",
		"@types/sinon": "22.0.0",
		"@types/superagent": "8.1.10",
		"cookie": "2.0.1",
		"eslint": "10.5.0",
		"eslint-config-prettier": "10.1.8",
		"fs-extra": "11.3.5",
		"globals": "17.7.0",
		"mocha": "11.7.6",
		"mongodb-memory-server": "11.2.0",
		"prettier": "3.8.4",
		"sinon": "22.0.0",
		"superagent": "10.3.0",
		"ts-node": "10.9.2",
		"typescript": "6.0.3",
		"typescript-eslint": "8.62.0"
	},
	"dependenciesMeta": {
		"mongodb-memory-server": {
			"built": true
		}
	},
	"packageManager": "yarn@4.17.0"
}
